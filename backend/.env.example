# Copy to .env — never commit .env
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/droboard
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_TTL=15m
MFA_TICKET_TTL=5m
MFA_STEPUP_MINUTES=5
MFA_SECRET_KEY=change-me-32bytes-encryption-key
CORS_ORIGINS=http://127.0.0.1:5501,http://localhost:5501
COOKIE_DOMAIN=
NODE_ENV=development

# Mail (any-type sender: src/services/mail.service.js)
# provider: log | resend | smtp (smtp needs: npm i nodemailer)
MAIL_PROVIDER=log
MAIL_FROM=Droboard <noreply@droboard.com>
APP_URL=http://127.0.0.1:5501
BACKEND_URL=http://127.0.0.1:4000
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Web flow needs all three; app/GIS idToken-only needs just the client IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5501/Pages/login.html
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Referrals: inviter-only staged rewards (defaults match spec)
REFERRAL_STAGE1_COINS=3
REFERRAL_STAGE2_COINS=2
REFERRAL_READ_SECONDS=1800
REFERRAL_WINDOW_DAYS=7

# Payments: verify-before-credit. Any channel without credentials fails
# closed (503) — purchases cannot credit until configured.
# App (Google Play Billing): package name + service-account JSON
# (Play Console > Setup > API access; product IDs must equal pack codes).
PLAY_PACKAGE_NAME=
PLAY_SERVICE_ACCOUNT_JSON=
# Web (Paystack): secret key verifies transactions + signs webhooks.
# Client must pass metadata { userId, packCode } when initializing.
PAYSTACK_SECRET=
# Web (Flutterwave): secret verifies transactions; set FLW_WEBHOOK_HASH to
# the exact value saved as webhook hash in the Flutterwave dashboard.
# Client must pass meta { userId, packCode } when charging.
FLW_SECRET_KEY=
FLW_WEBHOOK_HASH=
