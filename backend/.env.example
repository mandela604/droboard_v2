# Copy to backend/.env for local runs. On Render set these in
# Dashboard -> your service -> Environment (never commit real values).

# REQUIRED
MONGO_URI=mongodb://127.0.0.1:27017/droboard
JWT_ACCESS_SECRET=change-me-at-least-32-chars
JWT_REFRESH_SECRET=change-me-at-least-32-chars
CORS_ORIGINS=http://localhost:4000

# OPTIONAL
PORT=4000
JWT_ACCESS_TTL=15m
APP_URL=http://localhost:4000

# MFA is optional. Without this key the API still boots; MFA writes return
# 503 mfa_not_configured and the UI hides the toggle.
MFA_SECRET_KEY=

# Image uploads. Without BOTH of these, POST /api/uploads/image returns
# 503 images_not_configured and avatar/cover uploads stay disabled.
# Account ID: Cloudflare dashboard -> Images (it is also in the account URL).
# Token: My Profile -> API Tokens -> create token with "Cloudflare Images: Edit".
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_IMAGES_TOKEN=
