{
  "name": "droboard-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Droboard platform API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "smoke:ads": "node scripts/smoke-ad-surfaces.cjs",
    "smoke:audience": "node scripts/smoke-audience-catalog.cjs",
    "smoke:staff": "node scripts/smoke-staff-scopes.cjs",
    "smoke:staff:live": "node scripts/smoke-staff-live.cjs",
    "smoke:coins": "node scripts/smoke-superadmin-coins.cjs",
    "smoke:chief": "node scripts/smoke-chief-crud.cjs",
    "smoke:all": "node scripts/smoke-staff-scopes.cjs && node scripts/smoke-chief-crud.cjs && node scripts/smoke-staff-live.cjs && node scripts/smoke-superadmin-coins.cjs",
    "dev:memory": "node scripts/dev-inmemory.cjs",
    "report": "node scripts/report.cjs",
    "check:ad-registry": "node scripts/check-ad-registry.cjs",
    "smoke:auth:live": "node scripts/smoke-auth-live.cjs"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.4.0",
    "otplib": "^12.0.1",
    "socket.io": "^4.7.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.0"
  }
}
